# -----------------------------------------------------------------------------
# AirGuard local environment template
# Copy this file to .env and replace the placeholders with real values.
# NEVER commit .env. GitHub Actions uses repository Actions secrets instead.
# -----------------------------------------------------------------------------

# Shared persistent PostgreSQL database for ingestion + MLflow metadata.
# Use the provider's pooled URL for app traffic if desired; use the direct URL
# for one-time migrations. SQLAlchemy accepts postgresql:// URLs.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# MLflow persistent metadata/registry. Leave unset to use DATABASE_URL.
# MLFLOW_TRACKING_URI=
# MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_NAME=AirGuard-Production-Retrain

# MLflow artifact storage. Configure these together when using S3 / Cloudflare R2.
# Do not leave fake placeholder values uncommented: unset values allow local
# development to use local artifacts; GitHub Actions refuses to run without
# durable remote artifact storage.
# MLFLOW_ARTIFACT_URI=s3://YOUR-BUCKET/airguard/mlflow-artifacts
# AWS_ACCESS_KEY_ID=YOUR_OBJECT_STORAGE_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_OBJECT_STORAGE_SECRET_KEY
# Cloudflare R2: AWS_DEFAULT_REGION=auto and its account endpoint below.
# For AWS S3, set the real bucket region (e.g. ap-south-1) and regional endpoint.
# AWS_DEFAULT_REGION=ap-south-1
# MLFLOW_S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# Cloudflare R2 endpoint example:
# MLFLOW_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Ingestion API credentials
CPCB_API_KEY=
CPCB_PROXY_URL=
FIRMS_MAP_KEY=

# Copernicus Atmosphere Data Store (ADS), used by live CAMS ingestion.
# ADS is NOT the Climate Data Store (CDS); use the ADS account/token here.
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=

# Optional, separate Climate Data Store credentials for the offline ERA5 pressure
# backfill only. The normal scheduled workflows do not use these.
CDS_CLIMATE_API_URL=https://cds.climate.copernicus.eu/api
CDS_CLIMATE_API_KEY=

# Backend CORS: comma-separated exact frontend origins, no trailing slash.
AIRGUARD_CORS_ORIGINS=http://localhost:5173

# Frontend reads this at Vite build time (set in frontend/.env.local locally
# and in the frontend hosting provider's environment variables in production).
# VITE_API_BASE_URL=http://localhost:8000
